# MongoDB Atlas connection string (contoh: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sms_db?retryWrites=true&w=majority)
MONGODB_URI=

# Secret Auth.js. Buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Token Vercel Blob (Vercel Dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Akun Administrator (login tanpa database).
# Buat hash dengan: npm run hash-password -- "passwordAnda"  lalu tempel hasilnya di bawah.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=
